# Copy to .env (which is git-ignored) and fill in. docker compose reads it automatically.

# MySQL. rewriteBatchedStatements makes the history backfill much faster; createDatabaseIfNotExist needs CREATE rights.
DB_URL=jdbc:mysql://10.122.0.4:3306/nepbrain_nepse_analysis?serverTimezone=Asia/Kathmandu&characterEncoding=UTF-8&rewriteBatchedStatements=true&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DB_USERNAME=nepbrain
DB_PASSWORD=change-me

# Port inside and outside the container. 127.0.0.1 = reachable only through nginx on the same server.
APP_PORT=8083
APP_BIND=127.0.0.1

# Scheduled collection (true/false)
CRAWL_ENABLED=true
FLOORSHEET_ENABLED=true

# JVM memory
JVM_XMS=256m
JVM_XMX=1024m
